# Maintainer: Leandro <leandro@users.noreply.github.com>
pkgname=huskynext
pkgver=0.1.0
pkgrel=1
pkgdesc='Controle de iluminação do teclado Husky Sled com interface iced'
arch=('x86_64')
url='https://github.com/Leandro-74/HuskyNext-Rust'
license=('MIT')
depends=(
  'fontconfig'
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxinerama'
  'libxrandr'
  'libxkbcommon'
  'systemd-libs'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo' 'pkgconf' 'rust')
# Commit usado como fonte; atualize junto com sha256sums ao publicar uma versão.
_commit='9ad1663c5dfcc85d3567d5a323035edfd1f0ffdb'
source=("$pkgname-$pkgver.tar.gz::https://github.com/Leandro-74/HuskyNext-Rust/archive/$_commit.tar.gz")
sha256sums=('182b4bc04eb3ec93c30fa09062574ba1e1b27abe9fa475d877343d83a7eaee4c')

prepare() {
  cd "HuskyNext-Rust-$_commit"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "HuskyNext-Rust-$_commit"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release
}

check() {
  cd "HuskyNext-Rust-$_commit"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "HuskyNext-Rust-$_commit"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 PROTOCOL.md "$pkgdir/usr/share/doc/$pkgname/PROTOCOL.md"
  install -Dm644 assets/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/$pkgname.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=HuskyNext
GenericName=Keyboard Lighting Control
Comment=Controle de iluminação do teclado Husky Sled
Exec=huskynext
Icon=huskynext
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=husky;sled;keyboard;rgb;lighting;
StartupWMClass=huskynext
EOF

  install -d "$pkgdir/usr/lib/udev/rules.d"
  cat > "$pkgdir/usr/lib/udev/rules.d/99-huskynext.rules" <<'EOF'
# Husky Sled (Sonix 0C45:8501): acesso ao hidraw apenas para a sessão ativa.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8501", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8501", TAG+="uaccess"
EOF
}
